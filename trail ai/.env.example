# TRIAL AI Environment Configuration

# Application Mode
MOCK_MODE=true
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Map Provider: 'leaflet' (default offline/OSM), 'mock' (dev static), or 'google' (Google Maps Platform)
MAP_PROVIDER=leaflet
VITE_MAP_PROVIDER=leaflet

# Google Maps Platform (Required only when MAP_PROVIDER=google)
GOOGLE_MAPS_API_KEY=

# Firebase / Firestore (Optional for live persistence; mock mode used by default)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
